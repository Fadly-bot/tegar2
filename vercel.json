{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{index.php,AdminPanel.php,Login.php,Logout.php,Percobaan.php,Layout/**,service/**}"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/index\\.php$", "dest": "/api/index.php" },
    { "src": "^/(Login|AdminPanel|Logout|Percobaan)\\.php$", "dest": "/api/index.php?page=$1" },
    { "handle": "filesystem" }
  ]
}
